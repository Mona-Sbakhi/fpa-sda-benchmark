{
  "name": "cross_K2R_adult",
  "description": "Cross-dataset generalisation: trained on Kermany (paediatric), tested on the RSNA (adults, patient-grouped split) held-out test set (adult); frozen ResNet-50 features standardised with training statistics; same head, budget and settings as cnn_head; 20 runs.",
  "data": {
    "root": "/home/user/data/chest_xray",
    "size": 150,
    "cache_dir": "cache"
  },
  "features": {
    "type": "cnn",
    "path": "cache/resnet50_224.npz",
    "standardize": true,
    "external_test": "cache/rsna_adult_resnet50_224.npz"
  },
  "split": {
    "val_fraction": 0.2,
    "seed": 42
  },
  "model": {
    "hidden": [
      16
    ],
    "l2_lambda": 0.001,
    "class_weighted": true
  },
  "budget": {
    "pop_size": 45,
    "iterations": 150
  },
  "bounds": [
    -1.0,
    1.0
  ],
  "runs": 20,
  "seed0": 0,
  "output_dir": "results",
  "algorithms": {
    "Hybrid": {
      "type": "hybrid",
      "transition": 75,
      "mode": "transfer"
    },
    "SDA": {
      "type": "sda",
      "dispersal_probs": [
        0.7,
        0.15,
        0.15
      ]
    },
    "GA": {
      "type": "ga"
    },
    "L-SHADE": {
      "type": "lshade"
    }
  },
  "baselines": {
    "LogReg": {
      "type": "logreg",
      "C": 1.0
    },
    "MLP-Adam": {
      "type": "mlp_backprop",
      "solver": "adam",
      "lr": 0.001,
      "epochs": 150,
      "hidden": [
        16
      ]
    }
  }
}