{
  "name": "cnn_cma",
  "description": "CMA-type comparator: sep-CMA-ES on the CNN-head task, 50 runs with the same seeds as cnn_head; sigma0=0.3 chosen by validation MCC in cnn_cma_pilot (seeds 900-904).",
  "data": {
    "root": "/home/user/data/chest_xray",
    "size": 150,
    "cache_dir": "cache"
  },
  "features": {
    "type": "cnn",
    "path": "cache/resnet50_224.npz",
    "standardize": true
  },
  "split": {
    "val_fraction": 0.2,
    "seed": 42
  },
  "model": {
    "hidden": [
      16
    ],
    "l2_lambda": 0.001,
    "class_weighted": true
  },
  "budget": {
    "pop_size": 45,
    "iterations": 150
  },
  "bounds": [
    -1.0,
    1.0
  ],
  "runs": 50,
  "seed0": 0,
  "output_dir": "results",
  "algorithms": {
    "sep-CMA-ES": {
      "type": "sep_cmaes",
      "sigma0": 0.3
    }
  }
}